# Server
PORT=3000
NODE_ENV=development

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-key-here

# Zendesk OAuth (for Marketplace app)
ZENDESK_CLIENT_ID=your-zendesk-client-id
ZENDESK_CLIENT_SECRET=your-zendesk-client-secret
ZENDESK_REDIRECT_URI=https://your-domain.com/oauth/callback

# Webhook
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Testing
# 2026-11-05 11:12 +03: placeholder 965XXXXXXXX replaces a sample mobile number that belongs to a real person, int-testnumber
TEST_PHONE=965XXXXXXXX

# Database
DB_PATH=./data/kwtsms.db
